{
  "name": "personal-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @personal-ai-assistant/shared build && pnpm --filter @personal-ai-assistant/server start:dev",
    "start:server": "pnpm --filter @personal-ai-assistant/shared build && pnpm --filter @personal-ai-assistant/server start",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
