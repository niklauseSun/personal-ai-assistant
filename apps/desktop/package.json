{
  "name": "@personal-ai-assistant/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.node.json && vite build",
    "dev": "pnpm --dir ../.. --filter @personal-ai-assistant/shared build && concurrently \"tsc -p tsconfig.node.json --watch\" \"vite --host 127.0.0.1\" \"wait-on dist/main/main.js tcp:5173 && electron .\"",
    "test": "tsx --test src/main/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@personal-ai-assistant/shared": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
